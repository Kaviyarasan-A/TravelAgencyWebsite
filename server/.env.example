# ==========================================================
# Trip with uz — server environment variables (template)
# ==========================================================
# Copy this file to `server/.env` and fill in the real values.
# NEVER commit the real `.env` file.

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Recipient ---
# Comma-separate multiple addresses to CC every enquiry to all of them.
# Example: TO_EMAIL=primary@gmail.com,backup@gmail.com
TO_EMAIL=tripwithuzofficial@gmail.com

# --- WhatsApp ---
WHATSAPP_NUMBER=919585680636
# Optional WhatsApp Cloud API (for server-side push notifications).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# --- SMTP (Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tripwithuzofficial@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_NAME=Trip with uz
FROM_EMAIL=tripwithuzofficial@gmail.com

# --- Admin panel ---
ADMIN_USER=admin
ADMIN_PASS=change-me
ADMIN_SECRET=long-random-secret-at-least-32-characters

# --- Google Places API ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- UPI payments (booking confirm flow) ---
# VPA (UPI ID) that receives booking payments. e.g. tripwithuz@okicici
UPI_ID=tripwithuz@okicici
UPI_PAYEE_NAME=Trip with uz
